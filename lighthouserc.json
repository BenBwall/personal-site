{
  "$schema": "https://json.schemastore.org/lighthouserc.json",
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/", "http://localhost/projects/", "http://localhost/resume/"],
      "numberOfRuns": 3
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "network-dependency-tree-insight": "off",
        "render-blocking-insight": ["error", { "maxLength": 0 }],
        "render-blocking-resources": ["error", { "maxLength": 0 }],
        "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "categories:accessibility": [
          "error",
          { "minScore": 1, "aggregationMethod": "pessimistic" }
        ],
        "categories:best-practices": [
          "error",
          { "minScore": 1, "aggregationMethod": "pessimistic" }
        ],
        "categories:seo": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-reports"
    }
  }
}
