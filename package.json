{
  "name": "personal-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#scripts/*": "./scripts/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "test:lint-rules": "node --test scripts/oxlint-plugin.test.js"
  },
  "dependencies": {
    "@lucide/svelte": "^1.47.0",
    "simple-icons": "^16.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.6.1",
    "@types/ssh2": "^1.15.6",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "sharp": "^0.35.4",
    "ssh2": "^1.17.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
