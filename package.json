{
  "name": "personal-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/lib/components/*",
    "#inputs/*": "./src/lib/components/inputs/*",
    "#lib/*": "./src/lib/*",
    "#scripts/*": "./scripts/*",
    "#typography/*": "./src/lib/components/typography/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.scripts.json && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.scripts.json",
    "analyze": "fallow --fail-on-issues",
    "lint": "oxlint --max-warnings 0",
    "lighthouse": "lhci autorun",
    "validate:w3c": "bun scripts/validate-w3c.ts",
    "fmt": "oxfmt",
    "generate:resume-pdf": "bun scripts/generate-resume-pdf.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.52.0",
    "canvas-confetti": "^1.9.4",
    "leaflet": "^1.9.4",
    "simple-icons": "^16.34.0",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@rsvelte/oxlint-plugin": "^0.2.6",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/ssh2": "^1.15.6",
    "fallow": "^3.32.0",
    "lighthouse-ci-types": "github:GoogleChrome/lighthouse-ci#v0.15.1",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=22.17"
  }
}
