{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "svelte": true,
  "sortImports": true,
  "ignorePatterns": [
    "vendor/**",
    "node_modules/**",
    ".svelte-kit/**",
    "build/**",
    "dist/**"
  ]
}
